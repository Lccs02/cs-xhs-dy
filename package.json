{
  "name": "shoucang-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的小红书与抖音收藏整理工作台",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:enhanced": "node scripts/wxt-enhanced.mjs build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:enhanced": "node scripts/wxt-enhanced.mjs zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:stress": "vitest run tests/stress",
    "audit:package": "node scripts/audit-package.mjs .output/chrome-mv3-basic .output/chrome-mv3-enhanced-0.1.0",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run zip",
    "prepare:model": "node scripts/prepare-model.mjs",
    "verify:model": "node scripts/verify-model.mjs",
    "postinstall": "node scripts/copy-runtime.mjs && wxt prepare"
  },
  "dependencies": {
    "@huggingface/transformers": "3.7.6",
    "dexie": "4.4.6",
    "lucide-react": "0.544.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.1.33",
    "@types/node": "24.10.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "fake-indexeddb": "6.2.5",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "wxt": "0.21.4"
  }
}
